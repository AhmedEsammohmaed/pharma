# Copy to apps/api/.env and apps/web/.env.local
# Never commit real secrets. Never put service/secret keys in the frontend.

# --- Shared ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Client / publishable key (safe in the browser). New dashboard name for the anon key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- API only (apps/api/.env) ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# Used to verify access tokens locally (HS256). Requires SUPABASE_URL for issuer validation.
# Dashboard: Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=
# General PostgreSQL URI. Use a restricted application role for request traffic.
# Example: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Preferred restricted/non-superuser URL. If configured, the API uses this instead of DATABASE_URL.
# Do not use the Supabase service role or a PostgreSQL superuser for normal API requests.
DATABASE_URL_RLS=
# Secret/service key: webhooks, seed, admin Auth API. NEVER in Next.js.
SUPABASE_SECRET_KEY=

# --- Operator shell only (persistent procurement demo seed) ---
# Existing Supabase Auth user's email; the script adds demo pharmacy/supplier memberships.
DEMO_USER_EMAIL=
# Privileged migration/seed connection only. Never use this as the API request URL.
SEED_DATABASE_URL=

# --- Web only (apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:8000
